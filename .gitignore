node_modules/
.DS_Store
.env
*.sublime-workspace

# Uploaded photographs and the log itself: personal data, not source.
photos/
data/observations.json
data/species.json

# Map tiles cached from OpenStreetMap. Regenerated on demand.
tiles/

# Ground elevations cached from the USGS terrain model. Re-fetched on demand.
elevation/

# Weekly rainfall cached from Open-Meteo. One file per lattice cell, rewritten
# when the date rolls over.
rain/

# The iNaturalist archive: every research-grade record of a taxon across the
# home region, one file per taxon, plus the ground elevations under them.
# Rebuilt on demand.
inat/

# The Docker volume: config, data, photos and caches for a containerised run.
state/

# Reference material, kept out of the repo for size and licensing.
fungi_ebooks/
/research/