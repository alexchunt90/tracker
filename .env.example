# Restrict to this machine only. Default is 0.0.0.0, which makes the log
# reachable from your phone on the same network — and from anyone else on it,
# because there is no authentication.
# HOST=127.0.0.1

# PORT=4175

# Where config.json, data/, photos/ and tiles/ live. Defaults to the project
# directory. Must be a directory, not a file.
# STATE_DIR=/state

# Sent to OpenStreetMap and iNaturalist with every upstream request. Their
# terms ask that it identify the application and give a contact address.
# TRACKER_USER_AGENT=Tracker/1.0 (personal nature log; you@example.com)
